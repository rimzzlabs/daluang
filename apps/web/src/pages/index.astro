---
import { buttonVariants } from "@daluang/ui/components/button";
import { DaluangMark } from "@daluang/ui/components/daluang-mark";
import { ThemeToggle } from "@daluang/ui/components/theme-toggle";
import BaseLayout from "@/layouts/base-layout.astro";
---

<BaseLayout
	title="Daluang: a Markdown CMS that you host on Cloudflare"
	description="Daluang is an open-source Markdown CMS. It runs as a Cloudflare Worker on your own account."
>
	<header class="mx-auto flex w-full max-w-3xl items-center justify-between px-6 py-4">
		<a href="/" class="flex items-center gap-2 font-semibold">
			<DaluangMark className="h-5 w-auto" />
			Daluang
		</a>
		<nav class="flex items-center gap-1">
			<a href="/docs" class={buttonVariants({ variant: "ghost" })}>Docs</a>
			<ThemeToggle client:load />
		</nav>
	</header>
	<main class="mx-auto w-full max-w-3xl flex-1 px-6 py-24">
		<p class="font-mono text-xs tracking-wide text-muted-foreground uppercase">
			Early development
		</p>
		<h1 class="mt-4 font-serif text-5xl font-semibold tracking-tight text-balance">
			A Markdown CMS that you host on Cloudflare.
		</h1>
		<p class="mt-6 max-w-xl text-lg text-pretty text-muted-foreground">
			Write notes in Markdown. Daluang keeps them on your own Cloudflare account and
			publishes them to your site.
		</p>
		<div class="mt-10 flex gap-3">
			<a href="/docs" class={buttonVariants({ size: "lg" })}>Read the docs</a>
		</div>
	</main>
	<footer class="mx-auto w-full max-w-3xl px-6 py-8 text-sm text-muted-foreground">
		Open source under the MIT license.
	</footer>
</BaseLayout>
