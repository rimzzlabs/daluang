---
import { buttonVariants } from "@daluang/ui/components/button";
import { DaluangMark } from "@daluang/ui/components/daluang-mark";
import { ThemeToggle } from "@daluang/ui/components/theme-toggle";
import BaseLayout from "@/layouts/base-layout.astro";

// Each point is a decision that is already made. AGENTS.md has the open decisions.
const points = [
	{
		heading: "Your notes stay Markdown.",
		body: "Daluang stores each note as plain Markdown, not as HTML or rich text. Any Markdown tool can read it.",
	},
	{
		heading: "It runs on your Cloudflare account.",
		body: "Daluang is one Cloudflare Worker. Set your environment, fork the repository, and deploy. Your notes live in your account, not on a server that someone else runs.",
	},
	{
		heading: "Your site stays static.",
		body: "Readers get plain HTML from your site. When you publish a note, Daluang starts a rebuild of your site, so no server renders a page on each visit.",
	},
] as const;
---

<BaseLayout
	title="Daluang: a Markdown CMS for developers who write on their own site"
	description="Daluang is a Markdown CMS for developers who write on their own site. It publishes each note to the site you built, from your own Cloudflare account. Open source, MIT licensed."
>
	<header class="mx-auto flex w-full max-w-3xl items-center justify-between px-6 py-4">
		<a href="/" class="flex items-center gap-2 font-semibold">
			<DaluangMark className="h-5 w-auto" />
			Daluang
		</a>
		<nav class="flex items-center gap-1">
			<a href="/docs/" class={buttonVariants({ variant: "ghost", className: "h-11 sm:h-9" })}>
				Docs
			</a>
			<ThemeToggle client:load className="size-11 sm:size-9" />
		</nav>
	</header>

	<main class="mx-auto w-full max-w-3xl flex-1 px-6">
		<section class="pt-16 pb-20 sm:pt-24 sm:pb-28">
			<p class="text-sm text-muted-foreground">In early development</p>
			<h1
				class="mt-4 font-serif text-4xl font-semibold tracking-tight text-balance sm:text-6xl"
			>
				You built the site. Now write on it.
			</h1>
			<p class="mt-6 max-w-xl text-lg text-pretty text-muted-foreground">
				Daluang is a Markdown CMS for developers who write on their own site. You write in the
				browser, and Daluang publishes each note to the site you built, from your own
				Cloudflare account.
			</p>
			<div class="mt-10 flex flex-wrap gap-3">
				<a href="/docs/" class={buttonVariants({ size: "lg", className: "h-11" })}>
					Read the docs
				</a>
				<a
					href="https://github.com/rimzzlabs/daluang"
					class={buttonVariants({ variant: "outline", size: "lg", className: "h-11" })}
				>
					View source
				</a>
			</div>
		</section>

		<section aria-label="What Daluang does" class="border-t border-border">
			{
				points.map((point) => (
					<div class="grid gap-3 border-b border-border py-10 md:grid-cols-5 md:gap-8">
						<h2 class="font-serif text-2xl font-semibold tracking-tight md:col-span-2">
							{point.heading}
						</h2>
						<p class="text-pretty text-muted-foreground md:col-span-3">{point.body}</p>
					</div>
				))
			}
		</section>

		<section class="flex items-start gap-4 py-16">
			<DaluangMark className="mt-1 h-8 w-auto shrink-0 text-muted-foreground" />
			<p class="max-w-xl font-serif text-lg text-pretty italic">
				Daluang is the bark paper of old Sundanese manuscripts. The mark is the Sundanese
				letter da.
			</p>
		</section>

		<section class="border-t border-border py-20">
			<h2 class="font-serif text-3xl font-semibold tracking-tight">Free and open source.</h2>
			<p class="mt-4 max-w-xl text-pretty text-muted-foreground">
				The code is public under the MIT license. Daluang is in early development, and the
				editor and publishing are not ready yet. The docs say what works today.
			</p>
			<a
				href="https://github.com/rimzzlabs/daluang"
				class={buttonVariants({ variant: "outline", size: "lg", className: "mt-8 h-11" })}
			>
				Read the code on GitHub
			</a>
		</section>
	</main>

	<footer
		class="mx-auto flex w-full max-w-3xl items-center gap-2 px-6 py-8 text-sm text-muted-foreground"
	>
		<DaluangMark className="h-4 w-auto" />
		Daluang
	</footer>
</BaseLayout>
