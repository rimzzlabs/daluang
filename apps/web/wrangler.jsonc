{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "daluang-web",
	"compatibility_date": "2026-10-01",
	// A static site with no server code: the landing page, and the docs site at `/docs`.
	"assets": {
		"directory": "./dist",
		// A missing page gets the nearest `404.html`. Below `/docs`, that is the 404 page of
		// the docs site.
		"not_found_handling": "404-page",
		// The default, `auto-trailing-slash`, redirects `/docs` to `/docs/`. The router of
		// the docs site needs the slash on its root. A page of the landing page is a file
		// (`about.html`), so its URL has no slash.
		"html_handling": "auto-trailing-slash"
	},
	"routes": [{ "pattern": "daluang.rimzzlabs.com", "custom_domain": true }]
}
