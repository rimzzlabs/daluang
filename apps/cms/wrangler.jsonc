{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "daluang-cms",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// The database of the CMS. With no `database_id`, `wrangler deploy` makes the database
	// in your account. Apply `migrations/` with `pnpm db:migrate:local` or `db:migrate:remote`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "daluang",
			"migrations_dir": "migrations"
		}
	]
}
