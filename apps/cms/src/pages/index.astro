---
import { ThemeToggle } from "@/components/shared/theme-toggle";
import BaseLayout from "@/layouts/base-layout.astro";
---

<BaseLayout title="wcontent">
	<header class="mx-auto flex max-w-2xl items-center justify-between px-6 py-4">
		<span class="font-semibold">wcontent</span>
		<ThemeToggle client:load />
	</header>
	<main class="mx-auto max-w-2xl px-6 py-12">
		<h1 class="text-3xl font-semibold tracking-tight">Write in Markdown.</h1>
		<p class="mt-4 font-serif text-lg text-muted-foreground">
			The CMS keeps your notes and publishes them to your site.
		</p>
		<p class="mt-6 font-mono text-sm text-muted-foreground">pnpm dev</p>
	</main>
</BaseLayout>
