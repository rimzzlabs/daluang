---
import { SIGN_IN_PATH } from "@daluang/auth/paths";
import { listChanges } from "@daluang/notes/store";
import { ONBOARDING_PATH } from "@daluang/settings/onboarding";
import { SIDEBAR_WIDTH_REM } from "@daluang/ui/lib/sidebar-preferences";
import { AppShell } from "@/components/shell/app-shell";
import BaseLayout from "@/layouts/base-layout.astro";
import { createChangesStore } from "@/lib/notes/changes-store";
import { readNotesEnv } from "@/lib/notes/env";
import { createSettingsStore } from "@/lib/settings/settings-store";
import { documentTitle, findAppPage, pageTitle } from "@/lib/shell/app-pages";
import { App } from "@/routes/app";
import { PageContent } from "@/routes/page-content";

// Each path that is not the sign-in page and not an endpoint opens the app island. The
// client router of the island shows the page of the path.
const user = Astro.locals.user;
// The sign-in guard sends a request with no session to the sign-in page, so a user exists
// here. The check keeps the type narrow.
if (user === null) return Astro.redirect(SIGN_IN_PATH);
// The middleware of the settings sends a page to the onboarding when the settings are not
// complete. The check keeps the type narrow.
const settings = Astro.locals.settings;
if (settings?.status !== "complete") return Astro.redirect(ONBOARDING_PATH);

const { pathname } = Astro.url;
if (findAppPage(pathname) === undefined) Astro.response.status = 404;

const title = pageTitle(pathname);
const menuUser = { name: user.name, githubLogin: user.githubLogin, image: user.image ?? null };
// The HTML of the server reads the settings from a store, as the island does.
const store = createSettingsStore(settings.settings);
// The navbar shows the number of changes. The server gives it, so the button does not jump.
const changeCount = (await listChanges(readNotesEnv().DB)).length;
const changes = createChangesStore(changeCount);
---

<BaseLayout title={documentTitle(title)}>
	<div data-static-shell class="contents">
		<AppShell
			title={title}
			pathname={pathname}
			user={menuUser}
			defaultOpen={true}
			defaultWidth={SIDEBAR_WIDTH_REM.default}
			linkKind="anchor"
			settings={store}
			changes={changes}
		>
			<PageContent pathname={pathname} settings={store} changes={changes} />
		</AppShell>
	</div>
	<!-- `client:only`: the client router reads the browser history when it starts. -->
	<App
		client:only="react"
		user={menuUser}
		settings={settings.settings}
		changeCount={changeCount}
	/>
</BaseLayout>
