---
import { safeNext } from "@daluang/auth/safe-next";
import { signInError } from "@daluang/auth/sign-in-error";
import { Alert, AlertDescription, AlertTitle } from "@daluang/ui/components/alert";
import { DaluangMark } from "@daluang/ui/components/daluang-mark";
import { SignInButton } from "@/components/auth/sign-in-button";
import BaseLayout from "@/layouts/base-layout.astro";

const next = safeNext(Astro.url.searchParams.get("next"));
const error = signInError(Astro.url.searchParams.get("error"));
---

<BaseLayout title="Sign in · Daluang">
	<main class="flex min-h-dvh items-center justify-center px-6 py-16">
		<div class="w-full max-w-sm">
			<DaluangMark className="h-8 w-auto" />
			<h1 class="mt-6 font-serif text-2xl font-semibold tracking-tight">Sign in to Daluang</h1>
			<p class="mt-2 text-sm text-pretty text-muted-foreground">
				GitHub tells Daluang who you are. Only the GitHub users on the allow list of this CMS
				can sign in.
			</p>
			{
				error && (
					<Alert variant="destructive" className="mt-6">
						<AlertTitle>Could not sign you in</AlertTitle>
						<AlertDescription>
							<p>{error.message}</p>
							{error.code && <p class="font-mono text-xs">Error code: {error.code}</p>}
						</AlertDescription>
					</Alert>
				)
			}
			<SignInButton client:load next={next} className="mt-6" />
		</div>
	</main>
</BaseLayout>
