---
import { Font } from "astro:assets";
import { PREFERENCES_SCRIPT } from "@daluang/ui/lib/preferences-script";
import { STYLE_NONCE_PROPERTY } from "@/lib/security/style-nonce";
import "@/styles/global.css";

interface Props {
	title: string;
	/** The style nonce of the response. A page that inserts a `<style>` element gives it. */
	styleNonce?: string;
}

const { title, styleNonce } = Astro.props;
// The types of Astro have no `nonce` on `<meta>`, so the attributes come as one object.
const nonceMeta = { property: STYLE_NONCE_PROPERTY, nonce: styleNonce };
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<!-- First in the head: it applies the saved theme before the first paint. -->
		<script is:inline set:html={PREFERENCES_SCRIPT} />
		<title>{title}</title>
		<!-- The nonce for a `<style>` element that a script makes. `docs/security-headers.md`. -->
		{styleNonce && <meta {...nonceMeta} />}
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0c0a09" media="(prefers-color-scheme: dark)" />
		<Font cssVariable="--font-inter" preload />
		<Font cssVariable="--font-lora" />
		<Font cssVariable="--font-jetbrains-mono" />
	</head>
	<body class="min-h-dvh">
		<slot />
	</body>
</html>
