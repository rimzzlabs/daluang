{
	"name": "daluang",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"homepage": "https://daluang.rimzzlabs.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rimzzlabs/daluang.git"
	},
	"bugs": {
		"url": "https://github.com/rimzzlabs/daluang/issues"
	},
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --filter @daluang/cms dev",
		"build": "pnpm --filter @daluang/cms build",
		"preview": "pnpm --filter @daluang/cms preview",
		"db:migrate:local": "pnpm --filter @daluang/cms db:migrate:local",
		"web:dev": "pnpm --parallel --filter @daluang/docs --filter @daluang/web run dev",
		"web:build": "pnpm docs:build && pnpm --filter @daluang/web build",
		"web:preview": "pnpm --filter @daluang/web preview",
		"docs:dev": "pnpm --filter @daluang/docs dev",
		"docs:build": "pnpm --filter @daluang/docs build",
		"docs:preview": "pnpm --filter @daluang/docs preview",
		"typecheck": "pnpm --recursive --if-present typecheck",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"check": "biome check . && prettier --check \"**/*.{md,yml,yaml}\"",
		"fix": "biome check --write . && prettier --write \"**/*.{md,yml,yaml}\"",
		"prepare": "lefthook install",
		"commit": "commit"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@commitlint/prompt-cli": "catalog:",
		"@daluang/tsconfig": "workspace:*",
		"@vitest/coverage-v8": "catalog:",
		"lefthook": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
