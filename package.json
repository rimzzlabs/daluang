{
	"name": "wcontent",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --filter @wcontent/cms dev",
		"build": "pnpm --filter @wcontent/cms build",
		"preview": "pnpm --filter @wcontent/cms preview",
		"docs:dev": "pnpm --filter @wcontent/docs dev",
		"docs:build": "pnpm --filter @wcontent/docs build",
		"docs:preview": "pnpm --filter @wcontent/docs preview",
		"typecheck": "pnpm --recursive --if-present typecheck",
		"check": "biome check . && prettier --check \"**/*.{md,yml,yaml}\"",
		"fix": "biome check --write . && prettier --write \"**/*.{md,yml,yaml}\"",
		"prepare": "lefthook install",
		"commit": "commit"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@commitlint/prompt-cli": "catalog:",
		"@wcontent/tsconfig": "workspace:*",
		"lefthook": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:"
	}
}
